{
  "name": "televault",
  "version": "1.0.0",
  "private": true,
  "description": "Private, end-to-end encrypted photo and video library backed by Telegram",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"MOCK,WORKER,WEB\" -c \"magenta,cyan,green\" \"npm run dev:mock\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:mock": "npm run dev --workspace=tools/mock-telegram",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:secrets": "node scripts/secret-scan.mjs",
    "test:all": "npm run typecheck && npm run test && npm run test:secrets",
    "setup": "npx tsx scripts/setup.ts",
    "doctor": "npx tsx scripts/doctor.ts",
    "find-channel-id": "npx tsx scripts/find-channel-id.ts",
    "restore": "npx tsx scripts/restore.ts",
    "live-smoke": "npx tsx scripts/live-smoke.ts",
    "deploy": "npx tsx scripts/deploy.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
