# Cloudflare Worker secrets and environment variables
# For local development, copy this to .dev.vars
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890
ACCESS_TOKEN=tv_example_access_token_min_32_characters_random
SESSION_SECRET=tv_example_session_secret_hmac_key_min_32_chars
ENVIRONMENT=dev
# TELEGRAM_API_BASE is ONLY respected when ENVIRONMENT=dev
TELEGRAM_API_BASE=http://127.0.0.1:8788
